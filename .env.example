# نمونهٔ متغیرهای محیطی (با export در شل تنظیم شوند؛ فایل .env خودکار خوانده نمی‌شود).
# همهٔ موارد اختیاری‌اند؛ کلیدها را می‌توان از «تنظیمات» داخل رابط هم وارد کرد.
PORT=3000
TERMINUX_HOST=127.0.0.1
TERMINUX_WORKSPACE=
TERMINUX_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
GITHUB_TOKEN=
CLOUDFLARE_API_TOKEN=
TERMINUX_PASS_TOKENS_TO_SHELL=0
