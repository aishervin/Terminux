#!/data/data/com.termux/files/usr/bin/bash
# TΞRMINUX™ launcher (Fixed)
set -uo pipefail

PREFIX="${PREFIX:-/data/data/com.termux/files/usr}"
export PATH="$HOME/.opencode/bin:$PREFIX/bin:$PATH"

say()  { echo -e "\033[38;5;208m>\033[0m $*"; }
bad()  { echo -e "\033[38;5;203mERR:\033[0m $*"; }

ensure_server() {
  if ! opencode service status >/dev/null 2>&1; then
    say "Starting OpenCode server..."
    opencode service start >/dev/null 2>&1
    sleep 3
  fi
}

launch() {
  ensure_server
  say "Generating connection link..."
  LINK=$(opencode pair 2>/dev/null | grep -oE 'https?://[^ ]+/auth/connect/[A-Za-z0-9_-]+' | head -1)
  
  if [ -n "$LINK" ]; then
    say "Opening browser..."
    termux-open-url "$LINK" || xdg-open "$LINK" || echo "Open this link manually: $LINK"
  else
    bad "Failed to generate link. Server might be busy."
  fi
}

case "${1:-connect}" in
  connect|run|start) launch ;;
  stop)    opencode service stop && echo "Stopped." ;;
  status)  opencode service status ;;
  *)       bad "Unknown command: $1" ;;
esac
