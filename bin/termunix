#!/data/data/com.termux/files/usr/bin/bash
# TΞRMINUX™ launcher — OpenCode runs in Debian proot, never as an Android ELF.
set -Eeuo pipefail

PREFIX="${PREFIX:-/data/data/com.termux/files/usr}"
DISTRO="debian"
PORT="${TERMINUX_PORT:-49374}"
LOG_DIR="$HOME/.termunix"
LOG_FILE="$LOG_DIR/opencode.log"
mkdir -p "$LOG_DIR"
export PATH="$PREFIX/bin:$PATH"

say(){ printf '\033[38;5;208m[Terminux]\033[0m %s\n' "$*"; }
bad(){ printf '\033[38;5;203m[Terminux ERROR]\033[0m %s\n' "$*" >&2; }
need(){
  command -v proot-distro >/dev/null 2>&1 || { bad "Debian runtime missing. Re-run the Terminux installer."; exit 1; }
  proot-distro list 2>/dev/null | grep -Eq '(^|[[:space:]])debian([[:space:]]|$)' || { bad "Debian is not installed. Re-run the installer."; exit 1; }
}
linux(){ proot-distro login "$DISTRO" --shared-tmp -- "$@"; }
oc(){ linux bash -lc 'export PATH="$HOME/.opencode/bin:$HOME/.local/bin:$PATH"; exec opencode "$@"' _ "$@"; }

health(){
  if command -v curl >/dev/null 2>&1; then
    curl -fsS --max-time 2 "http://127.0.0.1:$PORT/global/health" >/dev/null 2>&1
  else
    return 1
  fi
}

start_service(){
  if health; then return 0; fi
  say "Starting the local OpenCode service on 127.0.0.1:$PORT ..."
  oc service start >>"$LOG_FILE" 2>&1 || {
    # Some OpenCode releases expose serve directly rather than the service manager.
    (nohup proot-distro login "$DISTRO" --shared-tmp -- bash -lc 'export PATH="$HOME/.opencode/bin:$HOME/.local/bin:$PATH"; exec opencode serve --hostname 127.0.0.1 --port '"$PORT" >>"$LOG_FILE" 2>&1 </dev/null &)
  }
  for _ in $(seq 1 25); do
    health && { say "Service is ready."; return 0; }
    sleep 1
  done
  bad "OpenCode did not become healthy. Log: $LOG_FILE"
  return 1
}

need
case "${1:-connect}" in
  connect|run|start|link)
    command -v curl >/dev/null 2>&1 || { bad "curl missing; run the installer."; exit 1; }
    start_service
    say "Creating a secure pairing link..."
    PAIR_OUTPUT="$(oc pair 2>&1 || true)"
    LINK="$(printf '%s\n' "$PAIR_OUTPUT" | grep -Eo 'https?://[^[:space:]]+/auth/connect/[A-Za-z0-9_-]+' | head -n 1 | tr -d '\r' || true)"
    if [ -z "$LINK" ]; then
      printf '%s\n' "$PAIR_OUTPUT"
      bad "Pairing URL not detected. Check $LOG_FILE"
      exit 1
    fi
    say "Opening Terminux in your browser..."
    if command -v termux-open-url >/dev/null 2>&1; then
      termux-open-url "$LINK" || { printf 'Open manually: %s\n' "$LINK"; exit 1; }
    else
      printf 'Open this link manually:\n%s\n' "$LINK"
    fi
    ;;
  status)
    need
    if health; then
      say "OpenCode is healthy at http://127.0.0.1:$PORT"
    else
      say "OpenCode is stopped or not responding."
      exit 1
    fi
    ;;
  stop)
    need
    oc service stop || true
    pkill -f "opencode serve --hostname 127.0.0.1 --port $PORT" 2>/dev/null || true
    say "Stop requested."
    ;;
  restart)
    "$0" stop || true
    "$0" start
    ;;
  logs)
    tail -n 100 "$LOG_FILE"
    ;;
  update)
    curl -fsSL https://raw.githubusercontent.com/aishervin/Terminux/main/install.sh | bash
    ;;
  uninstall)
    say "Removing Terminux files only; Debian and OpenCode data/sessions are preserved."
    rm -rf "$HOME/.config/opencode/plugins/termunix"
    rm -f "$HOME/.config/opencode/themes/terminux-charcoal.json"
    rm -f "$PREFIX/bin/termunix" "$PREFIX/bin/Terminux"
    say "Terminux launcher and skin removed. Runtime and sessions were not deleted."
    ;;
  *)
    bad "Usage: Terminux [connect|link|status|restart|stop|logs|update|uninstall]"
    exit 2
    ;;
esac
